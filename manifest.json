{
  "manifest_version": 3,
  "name": "Mattccessibility Tool",
  "version": "1.4.0",
  "description": "Automated QA accessibility auditor evaluating web pages against WCAG 2.2 AA standards with interactive :hover contrast, ARIA linter, tab navigation trail, color blindness lens, and vector PDF exports.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Mattccessibility Tool",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs",
    "sidePanel",
    "tts",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "file:///*"
  ]
}
